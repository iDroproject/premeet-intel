# PreMeet Environment Variables
# Copy to .env and fill in values.

# API Base URL — the root URL for PreMeet edge functions
VITE_API_BASE_URL=https://api.your-domain.com

# Stripe
STRIPE_API_KEY=your-stripe-restricted-key-here
STRIPE_PRO_PRICE_ID=your-pro-price-id-here
STRIPE_ENTERPRISE_PRICE_ID=your-enterprise-price-id-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Google OAuth — Chrome extension identity API
# Create at: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Chrome App type)
# The client ID must match the extension's public key / ID in the Chrome Web Store.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server-side copy of the OAuth client id — auth-google validates that Google
# access tokens were actually issued for THIS client (audience check). Set to the
# same value as VITE_GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CORS pinning (recommended for production): comma-separated list of the exact
# 32-char extension id(s) allowed to call the API. When set, ONLY these origins
# are accepted. Leave unset for local unpacked dev (any chrome-extension origin).
PREMEET_EXTENSION_IDS=

# BrightData — server-side only (used by enrichment-proxy edge function)
BRIGHTDATA_API_KEY=your-brightdata-api-key-here
# BrightData SERP unblocker customer id — injected server-side by enrichment-proxy
# so it never ships in the extension bundle.
BRIGHTDATA_SERP_CUSTOMER_ID=your-brightdata-serp-customer-id

# BrightData MCP (server-side only)
MCP_API_KEY=your-mcp-api-key-here

# Scheduled cleanup (Vercel Cron) — bearer secret the cron endpoint requires.
CRON_SECRET=generate-a-random-secret

# Dev-only auth endpoint (api/auth-dev). NEVER set these in production — the
# endpoint hard-fails on production deployments regardless. Requires BOTH.
# PREMEET_DEV_AUTH=1
# PREMEET_DEV_AUTH_SECRET=generate-a-random-secret

# Neon Serverless Postgres
# Get from the Neon dashboard after creating a project.
NEON_DATABASE_URL=postgres://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require

# JWT Secret for PreMeet session tokens (generate a random 256-bit hex string)
PREMEET_JWT_SECRET=your-jwt-secret-here
